# Marcadores vacíos. Copia este archivo a .env y sustituye cada valor.
# No pongas aquí el token real ni la contraseña de la base. .env no se versiona.

# Token del bot. Discord Developer Portal > Bot > Token.
DISCORD_TOKEN=

# PostgreSQL. El texto USUARIO, CONTRASENA y HOST es ficticio.
# Ejemplo local: postgresql://USUARIO:CONTRASENA@HOST:5432/bot_ventas
DATABASE_URL=

# development | production | test
NODE_ENV=development

# ID del canal foro donde cada publicación representa a un agente.
# Opcional. Si se define, /venta solo se acepta en hilos de ese canal.
FORUM_CHANNEL_ID=

# ID del servidor. Opcional. Si se define, los comandos se registran solo ahí y aparecen al momento.
# Si se deja vacío, el registro es global y puede tardar en aparecer.
DISCORD_GUILD_ID=

# Zona horaria IANA del periodo semanal. La semana va de lunes 00:00 al lunes siguiente.
DEPARTMENT_TIMEZONE=America/Bogota

# Rol o usuarios que pueden gestionar agentes, consultar /cobro y confirmar /pago.
# Quien tenga el permiso Administrador de Discord también puede hacerlo.
# Los IDs de usuario se separan con comas. Déjalos vacíos si solo usas administradores.
ADMIN_ROLE_ID=
ADMIN_USER_IDS=

# Resumen automático de los domingos. No registra pagos.
# WEEKLY_SUMMARY_ENABLED=false lo desactiva. Sin canal, tampoco se publica.
WEEKLY_SUMMARY_ENABLED=true
WEEKLY_SUMMARY_CHANNEL_ID=
WEEKLY_SUMMARY_HOUR=23
WEEKLY_SUMMARY_MINUTE=0
